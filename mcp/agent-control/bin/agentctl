#!/usr/bin/env sh
set -eu

# The marketplace installer exposes this launcher through a stable symlink such
# as ~/.local/bin/agentctl. Resolve that chain before deriving PACKAGE_DIR;
# using dirname($0) directly would incorrectly treat the user's bin directory
# as the package root and try to install dependencies there.
LAUNCHER_PATH="$0"
symlink_depth=0
while [ -L "$LAUNCHER_PATH" ]; do
  symlink_depth=$((symlink_depth + 1))
  if [ "$symlink_depth" -gt 40 ]; then
    echo "Refusing to resolve an agentctl symlink chain deeper than 40 links: $0" >&2
    exit 1
  fi

  launcher_dir="$(CDPATH= cd -P -- "$(dirname -- "$LAUNCHER_PATH")" && pwd)"
  link_target="$(readlink "$LAUNCHER_PATH")"
  case "$link_target" in
    /*) LAUNCHER_PATH="$link_target" ;;
    *) LAUNCHER_PATH="$launcher_dir/$link_target" ;;
  esac
done

SCRIPT_DIR="$(CDPATH= cd -P -- "$(dirname -- "$LAUNCHER_PATH")" && pwd)"
PACKAGE_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"

# Each process loads an immutable SQLite addon for its own Node ABI.
NODE_BIN="$(node -p 'process.execPath')"
AGENT_CONTROL_SQLITE_BINDING="$("$NODE_BIN" "$PACKAGE_DIR/runtime/bootstrap.mjs")"
export AGENT_CONTROL_SQLITE_BINDING

if [ -f "$PACKAGE_DIR/dist/cli.js" ]; then
  exec "$NODE_BIN" "$PACKAGE_DIR/dist/cli.js" "$@"
fi

exec "$NODE_BIN" "$PACKAGE_DIR/node_modules/tsx/dist/cli.mjs" "$PACKAGE_DIR/src/cli.ts" "$@"
